-- @mcp-fuse name=InstaReframeX6 kind=dctl_kernel type=tool
-- InstaReframe X6 v2.0: 360°-Reframe direkt aus den zwei Fisheye-Streams einer
-- Insta360 X6 (INSV-Streams 0+1). Mapping: echtes MEI-Modell mit der
-- Linsenkalibrierung aus den .insv-Metadaten (xi, fx, 13 Distorsionskoeff).
--
-- v2.0-Neuerungen:
--  * AUTO-KALIBRIERUNG: Liest eine .calib-Datei (tools/insv_calib.py erzeugt),
--    die neben dem Front-Clip (lens1.mp4) liegt; sonst eingebaute Defaults.
--    Caching: die Datei wird nur bei Pfad-Aenderung neu gelesen.
--  * DRAG-STEUERUNG: "Aim" ist ein Point-Control (Fadenkreuz im Viewer) —
--    Pan/Tilt per Maus ziehen statt nur ueber Slider.
--  * Y-down-Konvention (Welt aufrecht, Roll 0), Back per 180°-Y-Strahlrotation
--    (keine Pixel-Spiegelung) — alles offline verifiziert.
-- Inputs:  Front = Stream 1 (vordere Linse, z>=0), Back = Stream 0 (hinten, z<0)

FuRegisterClass("InstaReframeX6", CT_Tool, {
    REGS_Category = "Fuses\\Insta360",
    REGS_OpIconString = "X6R",
    REGS_OpDescription = "Reframe aus 2 Insta360-X6-Fisheye-Streams (MEI-Kalibrierung, Auto)",
})

KernelParams = [[
    float FOV;
    float Pan;
    float Tilt;
    float Roll;
    float fxi;  float ffx;  float ffy;  float fcx;  float fcy;
    float fk1;  float fk2;  float fk3;  float fk4;
    float fp1;  float fp2;
    float fs1;  float fs2;  float fs3;  float fs4;
    float bxi;  float bfx;  float bfy;  float bcx;  float bcy;
    float bk1;  float bk2;  float bk3;  float bk4;
    float bp1;  float bp2;
    float bs1;  float bs2;  float bs3;  float bs4;
    float fm0;  float fm1;  float fm2;  float fm3;  float fm4;
    float fm5;  float fm6;  float fm7;  float fm8;
    float bm0;  float bm1;  float bm2;  float bm3;  float bm4;
    float bm5;  float bm6;  float bm7;  float bm8;
    float byaw;   // Naht-Feinabgleich: zusaetzliche Y-Rotation der Back-Linse (rad)
    float bpitch; // Naht-Feinabgleich: zusaetzliche X-Rotation der Back-Linse (rad)
    int   insize[2];
    int   outsize[2];
]]

KernelSource = [[
__KERNEL__ void InstaReframeX6Kernel(__CONSTANTREF__ KernelParams *params,
                                     __TEXTURE2D__ src,
                                     __TEXTURE2D__ src2,
                                     __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y);
    if (x < params->outsize[0] && y < params->outsize[1])
    {
        const float PI = 3.14159265358979f;

        // Pixel -> Richtungsvektor. MEI-Kalibrierung arbeitet in Y-DOWN-
        // Konvention (cy ist Bildzeile, v waechst nach unten): NUR x invertieren
        // (Bild-x rechts => Sphaere +x), y NICHT negieren (Bild-y unten => +y).
        float focal = (params->outsize[1] * 0.5f) / _tanf(params->FOV * 0.5f * PI / 180.0f);
        float dx = ((float)x - params->outsize[0] * 0.5f) / focal;
        float dy = ((float)y - params->outsize[1] * 0.5f) / focal;
        float dz = 1.0f;

        // Roll um Z
        float cr = _cosf(params->Roll * PI / 180.0f);
        float sr = _sinf(params->Roll * PI / 180.0f);
        float x1 = cr * dx - sr * dy;
        float y1 = sr * dx + cr * dy;
        float z1 = dz;

        // Tilt um X
        float ct = _cosf(params->Tilt * PI / 180.0f);
        float st = _sinf(params->Tilt * PI / 180.0f);
        float x2 = x1;
        float y2 = ct * y1 - st * z1;
        float z2 = st * y1 + ct * z1;

        // Pan um Y
        float cp = _cosf(params->Pan * PI / 180.0f);
        float sp = _sinf(params->Pan * PI / 180.0f);
        float x3 = cp * x2 + sp * z2;
        float y3 = y2;
        float z3 = -sp * x2 + cp * z2;

        // normalisieren
        float inv = 1.0f / _sqrtf(x3*x3 + y3*y3 + z3*z3);
        x3 *= inv; y3 *= inv; z3 *= inv;

        float iw = (float)params->insize[0];
        float ih = (float)params->insize[1];
        float u, v;
        int ok = 0;

        if (z3 >= 0.0f)
        {
            // ---- Front (Stream 1): extrinsisch nur yaw/pitch (klein) ----
            // R_front.T @ ray (Kalibrierung)
            float Xl = params->fm0*x3 + params->fm1*y3 + params->fm2*z3;
            float Yl = params->fm3*x3 + params->fm4*y3 + params->fm5*z3;
            float Zl = params->fm6*x3 + params->fm7*y3 + params->fm8*z3;
            // MEI forward
            float norm = _sqrtf(Xl*Xl + Yl*Yl + Zl*Zl);
            if (norm > 1e-6f)
            {
                float Xs = Xl / norm, Ys = Yl / norm, Zs = Zl / norm;
                float denom = Zs + params->fxi;
                if (denom > 1e-4f)
                {
                    float mx = Xs / denom;
                    float my = Ys / denom;
                    float r2 = mx*mx + my*my;
                    float r4 = r2*r2;
                    float radial = 1.0f + params->fk1*r2 + params->fk2*r4 + params->fk3*r2*r4 + params->fk4*r4*r4;
                    float xd = mx*radial + 2.0f*params->fp1*mx*my + params->fp2*(r2 + 2.0f*mx*mx) + params->fs1*r2 + params->fs2*r4;
                    float yd = my*radial + params->fp1*(r2 + 2.0f*my*my) + 2.0f*params->fp2*mx*my + params->fs3*r2 + params->fs4*r4;
                    u = params->ffx*xd + params->fcx;
                    v = params->ffy*yd + params->fcy;
                    float rmax = (iw < ih ? iw : ih) * 0.5f * 0.97f;
                    float du = u - params->fcx, dv = v - params->fcy;
                    if (_sqrtf(du*du + dv*dv) <= rmax && u >= 0.0f && u <= iw - 1.0f && v >= 0.0f && v <= ih - 1.0f)
                    {
                        ok = 1;
                    }
                }
            }
            if (ok)
            {
                _tex2DVec4Write(dst, x, y, _tex2DVecN(src, u / (iw - 1.0f), v / (ih - 1.0f), 15));
            }
        }
        else
        {
            // ---- Back (Stream 0): 180°-Y-Rotation (x,z -> -x,-z) + klein ----
            // R_back.T @ ray (Kalibrierung)
            float Xl = params->bm0*x3 + params->bm1*y3 + params->bm2*z3;
            float Yl = params->bm3*x3 + params->bm4*y3 + params->bm5*z3;
            float Zl = params->bm6*x3 + params->bm7*y3 + params->bm8*z3;
            // Naht-Feinabgleich: zusaetzliche Yaw-/Pitch-Rotation der Back-Linse
            // (korrigiert den Restversatz an der Naht; Default 0 = reine Kalibrierung)
            if (params->byaw != 0.0f)
            {
                float cy = _cosf(params->byaw), sy = _sinf(params->byaw);
                float Xr = cy*Xl - sy*Zl;
                float Zr = sy*Xl + cy*Zl;
                Xl = Xr; Zl = Zr;
            }
            if (params->bpitch != 0.0f)
            {
                float cp = _cosf(params->bpitch), sp = _sinf(params->bpitch);
                float Yr = cp*Yl - sp*Zl;
                float Zr2 = sp*Yl + cp*Zl;
                Yl = Yr; Zl = Zr2;
            }
            // MEI forward
            float norm = _sqrtf(Xl*Xl + Yl*Yl + Zl*Zl);
            if (norm > 1e-6f)
            {
                float Xs = Xl / norm, Ys = Yl / norm, Zs = Zl / norm;
                float denom = Zs + params->bxi;
                if (denom > 1e-4f)
                {
                    float mx = Xs / denom;
                    float my = Ys / denom;
                    float r2 = mx*mx + my*my;
                    float r4 = r2*r2;
                    float radial = 1.0f + params->bk1*r2 + params->bk2*r4 + params->bk3*r2*r4 + params->bk4*r4*r4;
                    float xd = mx*radial + 2.0f*params->bp1*mx*my + params->bp2*(r2 + 2.0f*mx*mx) + params->bs1*r2 + params->bs2*r4;
                    float yd = my*radial + params->bp1*(r2 + 2.0f*my*my) + 2.0f*params->bp2*mx*my + params->bs3*r2 + params->bs4*r4;
                    u = params->bfx*xd + params->bcx;
                    v = params->bfy*yd + params->bcy;
                    float rmax = (iw < ih ? iw : ih) * 0.5f * 0.97f;
                    float du = u - params->bcx, dv = v - params->bcy;
                    if (_sqrtf(du*du + dv*dv) <= rmax && u >= 0.0f && u <= iw - 1.0f && v >= 0.0f && v <= ih - 1.0f)
                    {
                        ok = 1;
                    }
                }
            }
            if (ok)
            {
                _tex2DVec4Write(dst, x, y, _tex2DVecN(src2, u / (iw - 1.0f), v / (ih - 1.0f), 15));
            }
        }
    }
}
]]

-- Eingebaute Default-Kalibrierung (verifizierte X6, VID_20260918_205557_00_014)
local DEFAULT_CALIB = {
    fxi=2.45543, ffx=3611.11, ffy=3611.11, fcx=1926.45, fcy=1939.42,
    fk1=1.31325, fk2=-1.59305, fk3=6.99536, fk4=-2.58052,
    fp1=-0.00102256, fp2=-0.00163018,
    fs1=-0.00392101, fs2=0.0146974, fs3=0.00406541, fs4=0.00244077,
    bxi=2.45543, bfx=3603.76, bfy=3603.76, bcx=1930.63, bcy=1943.50,
    bk1=1.27913, bk2=-0.752754, bk3=0.472147, bk4=15.4547,
    bp1=0.00126113, bp2=0.00033189,
    bs1=-0.0065367, bs2=0.0131532, bs3=-0.00036284, bs4=-0.00159663,
    fm0=0.999973, fm1=0.0, fm2=-0.007295, fm3=-0.000023, fm4=0.999995,
    fm5=-0.003142, fm6=0.007295, fm7=0.003142, fm8=0.999968,
    bm0=-0.999986, bm1=0.0, bm2=-0.005288, bm3=-0.000016, bm4=0.999995,
    bm5=0.003107, bm6=0.005288, bm7=0.003107, bm8=-0.999981,
}

-- Text-Extraktion aus Text-Inputs: Resolve 21 liefert cdata<struct Text *>,
-- nicht string. Probier-Kette aller bekannten Konventionen.
local function textValue(inp, req)
    local ok, v = pcall(function() return inp:GetValue(req) end)
    if not ok or v == nil then return nil end
    if type(v) == "string" then return v end
    -- cdata: ..Value / [1] / tostring-nicht-Adresse / ffi.string
    local tries = {
        function() return v.Value end,
        function() return v.value end,
        function() return v[1] end,
        function() return v[0] end,
        function() return v.Text end,
        function() return v.text end,
    }
    for i, fn in ipairs(tries) do
        local ok2, r = pcall(fn)
        if ok2 and type(r) == "string" then return r end
    end
    -- ffi.string direkt auf dem Pointer (wenn verfuegbar)
    local okF, rF = pcall(function()
        if ffi and ffi.string then return ffi.string(v) end
        return nil
    end)
    if okF and type(rF) == "string" then return rF end
    -- letzter Versuch: tostring, aber Adressformat verwerfen
    local okT, rT = pcall(function() return tostring(v) end)
    if okT and type(rT) == "string" and rT:match("^cdata") == nil and rT:match("^table") == nil then
        return rT
    end
    return nil
end

-- Cache fuer Auto-Kalibrierung (Datei nur bei Pfad-Aenderung neu lesen)
local calibCache = nil
local calibCachePath = nil
local calibCacheMtime = nil

local function parseCalibFile(path)
    local okF, f = pcall(function() return io.open(path, "r") end)
    if not okF or not f then return nil end
    local t = {}
    for line in f:lines() do
        line = line:gsub("%s+$", "")
        local k, v = line:match("^([%w_]+)=(%-?[%d%.eE]+)$")
        if k and v then
            local n = tonumber(v)
            if n then t[k] = n end
        end
    end
    f:close()
    return t
end

-- Findet .calib automatisch: gleicher Basisname wie der Front-Clip.
-- HINWEIS: Im Fuse-Kontext ist die Comp-API abgeschnitten (Resolve 21:
-- GetToolList/FindTool/CurrentComp nicht verfuegbar), daher ist die
-- Auto-Suche ein Best-Effort-Fallback — primaer ist der CalibFile-Input.
local function findCalibPath(req)
    -- Strategie D (bevorzugt, keine Comp-API): Pfad aus der Front-Textur.
    -- Fusion-Images haben IMG_Attrs mit Quell-Info (z.B. IMG_FilePath).
    if InFront then
        local okI, img = pcall(function() return InFront:GetValue(req) end)
        if okI and img then
            local okA, attrs = pcall(function() return img:GetAttrs() end)
            if okA and attrs then
                for _, key in ipairs({ "IMG_FilePath", "IMG_Source", "IMG_FileName", "TOOLS_Clip_Path" }) do
                    local okV, v = pcall(function() return attrs[key] end)
                    if okV and type(v) == "string" and v ~= "" then
                        local base = v:match("^(.*)%.[%w]+$") or v
                        local cand = base .. ".calib"
                        local okF, f = pcall(function() return io.open(cand, "r") end)
                        if okF and f then
                            f:close()
                            return cand
                        end
                    end
                end
            end
        end
    end

    local comp = self.Comp or comp or comp2 or fusion.CurrentComp
    if not comp then return nil end

    -- Strategie A: GetToolList
    local tool = nil
    local okC, list = pcall(function() return comp:GetToolList(false) end)
    if okC and type(list) == "table" then
        for i, t in pairs(list) do
            local okN, name = pcall(function() return t:GetAttrs().TOOLS_Name end)
            if okN and name == "MediaIn1" then tool = t break end
        end
    end

    -- Strategie B: FindTool direkt
    if not tool then
        local okF, t = pcall(function() return comp:FindTool("MediaIn1") end)
        if okF and t then tool = t end
    end

    -- Strategie C: CurrentComp.FindTool
    if not tool then
        local okF, t = pcall(function() return fusion:GetCurrentComp():FindTool("MediaIn1") end)
        if okF and t then tool = t end
    end

    if not tool then
        return nil
    end

    local okP, clip = pcall(function() return tool:GetAttrs().TOOLS_Clip_Path end)
    if okP and clip and clip ~= "" then
        local base = clip:match("^(.*)%.[%w]+$") or clip
        local cand = base .. ".calib"
        local okF2, f = pcall(function() return io.open(cand, "r") end)
        if okF2 and f then
            f:close()
            return cand
        end
    end
    return nil
end

function Create()
    InFOV = self:AddInput("FOV", "FOV", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 60.0,
        INP_MinScale = 15.0,
        INP_MaxScale = 170.0,
    })

    InPan = self:AddInput("Pan", "Pan (Yaw)", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -180.0,
        INP_MaxScale = 180.0,
    })

    InTilt = self:AddInput("Tilt", "Tilt (Pitch)", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -90.0,
        INP_MaxScale = 90.0,
    })

    -- NAHT-FEINABGLEICH: korrigiert den Restversatz zwischen Front- und
    -- Back-Linse direkt an der Naht (Winkel in Grad). 0 = reine Kalibrierung.
    InBackYaw = self:AddInput("BackYaw", "Naht-Feinabgleich Yaw (Grad)", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -5.0,
        INP_MaxScale = 5.0,
    })
    InBackPitch = self:AddInput("BackPitch", "Naht-Feinabgleich Pitch (Grad)", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -5.0,
        INP_MaxScale = 5.0,
    })

    InRoll = self:AddInput("Roll", "Roll", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = -180.0,
        INP_MaxScale = 180.0,
    })

    -- KALIBRIERUNG: expliziter Pfad (bevorzugt; setzt das Import-Skript
    -- automatisch). Leer = automatische Suche neben dem Front-Clip.
    -- ROBUST: pcall — TextEditControl wurde von dieser Resolve-Version
    -- abgelehnt (Create brach ab); dann entfaellt nur der explizite Pfad.
    -- Variante 2: OHNE INP_Default (leerer String koennte der Stolperstein
    -- sein — 'cannot convert table to double' deutete auf Default-Problem).
    local calOk = pcall(function()
        InCalibFile = self:AddInput("CalibFile", "Kalibrierungsdatei (.calib)", {
            LINKID_DataType = "Text",
            INPID_InputControl = "TextEditControl",
        })
    end)
    if not calOk then
        InCalibFile = nil
        LogFuse("CalibFile-Input nicht unterstuetzt — nur Auto-Suche")
    end

    -- DRAG-STEUERUNG: Point-Control (Fadenkreuz im Viewer). Ziehen setzt
    -- Pan/Tilt. Mittelpunkt (0.5,0.5) = geradeaus.
    -- ROBUST: pcall-gekapselt — falls diese Resolve-Version PointControl mit
    -- Table-Default ablehnt (bad argument #3, Create brach ab), laedt der Fuse
    -- trotzdem komplett und nur die Drag-Geste entfaellt.
    local aimOk = pcall(function()
        InAim = self:AddInput("Aim", "Blickrichtung (im Viewer ziehen)", {
            LINKID_DataType = "Point",
            INPID_InputControl = "PointControl",
            INP_Default = { 0.5, 0.5 },
        })
    end)
    if not aimOk then
        InAim = nil
        LogFuse("Aim-PointControl nicht unterstuetzt — Drag deaktiviert, Slider nutzen")
    end

    InAspect = self:AddInput("Aspect", "Aspect Ratio", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
        INP_Default = 0,
        { CCS_AddString = "4K UHD (3840x2160)" },
        { CCS_AddString = "16:9 (1920x1080)" },
        { CCS_AddString = "9:16 (1080x1920)" },
        { CCS_AddString = "1:1 (1080x1080)" },
        { CCS_AddString = "4:5 (1080x1350)" },
        { CCS_AddString = "9:21 (1080x2520)" },
        { CCS_AddString = "Custom" },
        CC_LabelPosition = "Horizontal",
    })

    InOutW = self:AddInput("OutWidth", "Output Breite", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 1920.0,
        INP_MinScale = 16.0,
        INP_MaxScale = 7680.0,
    })

    InOutH = self:AddInput("OutHeight", "Output Hoehe", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 1080.0,
        INP_MinScale = 16.0,
        INP_MaxScale = 4320.0,
    })

    InFront = self:AddInput("Front", "Front", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    InBack = self:AddInput("Back", "Back", {
        LINKID_DataType = "Image",
        LINK_Main = 2,
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })
end

function Process(req)
    local ok, perr = pcall(function()
        local front = InFront:GetValue(req)
        local back  = InBack:GetValue(req)

        if not (front and back) then
            OutImage:Set(req, Image({ IMG_Like = front or back }))
            return
        end

        local ow = math.floor(InOutW:GetValue(req).Value + 0.5)
        local oh = math.floor(InOutH:GetValue(req).Value + 0.5)

        -- Aspect-Preset (0-basiert: 0=4K ... 5=9:21, 6=Custom). pcall-gesichert.
        local aspect = -1
        local okR, av = pcall(function() return InAspect:GetValue(req) end)
        if okR then
            if type(av) == "number" then
                aspect = av
            else
                local okV, v = pcall(function() return av.Value end)
                if okV and type(v) == "number" then aspect = v end
            end
        end
        if aspect == 0 then ow, oh = 3840, 2160
        elseif aspect == 1 then ow, oh = 1920, 1080
        elseif aspect == 2 then ow, oh = 1080, 1920
        elseif aspect == 3 then ow, oh = 1080, 1080
        elseif aspect == 4 then ow, oh = 1080, 1350
        elseif aspect == 5 then ow, oh = 1080, 2520
        end

        ow = math.max(16, math.min(7680, ow))
        oh = math.max(16, math.min(4320, oh))

        -- DRAG: Aim-Point (0..1) -> Pan/Tilt. Mittelpunkt = geradeaus.
        -- X: 0..1 -> Pan -180..180 ; Y: 0..1 -> Tilt +90..-90 (Y-down).
        local pan = InPan:GetValue(req).Value
        local tilt = InTilt:GetValue(req).Value
        if InAim then
            local okA, aim = pcall(function() return InAim:GetValue(req) end)
            if okA and aim then
                local ax, ay = 0.5, 0.5
                if type(aim) == "table" then
                    ax = aim.X or aim[1] or 0.5
                    ay = aim.Y or aim[2] or 0.5
                else
                    local okX, xv = pcall(function() return aim.X end)
                    local okY, yv = pcall(function() return aim.Y end)
                    if okX and type(xv) == "number" then ax = xv end
                    if okY and type(yv) == "number" then ay = yv end
                end
                pan  = (ax - 0.5) * 360.0
                tilt = (0.5 - ay) * 180.0
            end
        end

        -- Zielbild wie im offiziellen GPU sample.fuse erzeugen.
        local xa, ya = 1, 1
        if front.XAspectX and front.XAspectX ~= 0 then
            xa = front.XAspectX
            ya = front.YAspectY or 1
        end
        local img = Image({
            IMG_Document = self.Comp,
            IMG_Width = ow,
            IMG_Height = oh,
            IMG_XScale = xa,
            IMG_YScale = ya,
            IMG_Quality = not req:IsQuick(),
            IMG_MotionBlurQuality = not req:IsNoMotionBlur(),
        })
        if not img then
            LogFuse("Image() failed")
            OutImage:Set(req, Image({ IMG_Like = front }))
            return
        end
        local out = Image({ IMG_Like = img })

        local node = DVIPComputeNode(req, "InstaReframeX6Kernel", KernelSource,
                                     "KernelParams", KernelParams)
        if not node then
            LogFuse("DVIPComputeNode failed")
            OutImage:Set(req, out)
            return
        end

        -- KALIBRIERUNG (Prioritaet):
        -- 1) Expliziter CalibFile-Input (setzt das Import-Skript).
        -- 2) Sonst Auto-Suche neben dem Front-Clip.
        -- Robust: lesen nur wenn Pfad gesetzt ist; Datei ist ~1 KB, frisch
        -- lesen ist billiger als ein fehlschlagender mtime-Cache in Clip-Comps.
        local calib = DEFAULT_CALIB
        local calibPath = nil
        local okCf = false
        if InCalibFile then
            local tv = textValue(InCalibFile, req)
            if tv and tv ~= "" then
                calibPath = tv
                okCf = true
            end
        end
        if not calibPath then
            calibPath = findCalibPath(req)
        end
        if calibPath and calibPath ~= "" then
            local t = parseCalibFile(calibPath)
            if t and next(t) then
                calib = t
            end
        end

        local function cv(key, dflt)
            local v = calib[key]
            if v == nil then return dflt end
            return v
        end

        local paramblock = node:GetParamBlock(KernelParams)
        paramblock.FOV    = InFOV:GetValue(req).Value
        paramblock.Pan    = pan
        paramblock.Tilt   = tilt
        paramblock.Roll   = InRoll:GetValue(req).Value
        paramblock.fxi = cv("front_xi", DEFAULT_CALIB.fxi)
        paramblock.ffx = cv("front_fx", DEFAULT_CALIB.ffx)
        paramblock.ffy = cv("front_fy", DEFAULT_CALIB.ffy)
        paramblock.fcx = cv("front_cx", DEFAULT_CALIB.fcx)
        paramblock.fcy = cv("front_cy", DEFAULT_CALIB.fcy)
        paramblock.fk1 = cv("front_k1", DEFAULT_CALIB.fk1)
        paramblock.fk2 = cv("front_k2", DEFAULT_CALIB.fk2)
        paramblock.fk3 = cv("front_k3", DEFAULT_CALIB.fk3)
        paramblock.fk4 = cv("front_k4", DEFAULT_CALIB.fk4)
        paramblock.fp1 = cv("front_p1", DEFAULT_CALIB.fp1)
        paramblock.fp2 = cv("front_p2", DEFAULT_CALIB.fp2)
        paramblock.fs1 = cv("front_s1", DEFAULT_CALIB.fs1)
        paramblock.fs2 = cv("front_s2", DEFAULT_CALIB.fs2)
        paramblock.fs3 = cv("front_s3", DEFAULT_CALIB.fs3)
        paramblock.fs4 = cv("front_s4", DEFAULT_CALIB.fs4)
        paramblock.bxi = cv("back_xi", DEFAULT_CALIB.bxi)
        paramblock.bfx = cv("back_fx", DEFAULT_CALIB.bfx)
        paramblock.bfy = cv("back_fy", DEFAULT_CALIB.bfy)
        paramblock.bcx = cv("back_cx", DEFAULT_CALIB.bcx)
        paramblock.bcy = cv("back_cy", DEFAULT_CALIB.bcy)
        paramblock.bk1 = cv("back_k1", DEFAULT_CALIB.bk1)
        paramblock.bk2 = cv("back_k2", DEFAULT_CALIB.bk2)
        paramblock.bk3 = cv("back_k3", DEFAULT_CALIB.bk3)
        paramblock.bk4 = cv("back_k4", DEFAULT_CALIB.bk4)
        paramblock.bp1 = cv("back_p1", DEFAULT_CALIB.bp1)
        paramblock.bp2 = cv("back_p2", DEFAULT_CALIB.bp2)
        paramblock.bs1 = cv("back_s1", DEFAULT_CALIB.bs1)
        paramblock.bs2 = cv("back_s2", DEFAULT_CALIB.bs2)
        paramblock.bs3 = cv("back_s3", DEFAULT_CALIB.bs3)
        paramblock.bs4 = cv("back_s4", DEFAULT_CALIB.bs4)
        paramblock.fm0 = cv("front_m0", DEFAULT_CALIB.fm0)
        paramblock.fm1 = cv("front_m1", DEFAULT_CALIB.fm1)
        paramblock.fm2 = cv("front_m2", DEFAULT_CALIB.fm2)
        paramblock.fm3 = cv("front_m3", DEFAULT_CALIB.fm3)
        paramblock.fm4 = cv("front_m4", DEFAULT_CALIB.fm4)
        paramblock.fm5 = cv("front_m5", DEFAULT_CALIB.fm5)
        paramblock.fm6 = cv("front_m6", DEFAULT_CALIB.fm6)
        paramblock.fm7 = cv("front_m7", DEFAULT_CALIB.fm7)
        paramblock.fm8 = cv("front_m8", DEFAULT_CALIB.fm8)
        paramblock.bm0 = cv("back_m0", DEFAULT_CALIB.bm0)
        paramblock.bm1 = cv("back_m1", DEFAULT_CALIB.bm1)
        paramblock.bm2 = cv("back_m2", DEFAULT_CALIB.bm2)
        paramblock.bm3 = cv("back_m3", DEFAULT_CALIB.bm3)
        paramblock.bm4 = cv("back_m4", DEFAULT_CALIB.bm4)
        paramblock.bm5 = cv("back_m5", DEFAULT_CALIB.bm5)
        paramblock.bm6 = cv("back_m6", DEFAULT_CALIB.bm6)
        paramblock.bm7 = cv("back_m7", DEFAULT_CALIB.bm7)
        paramblock.bm8 = cv("back_m8", DEFAULT_CALIB.bm8)
        -- Naht-Feinabgleich (Grad -> Radiant): Slider liefern userdata mit .Value
        -- (wie InPan/InTilt) — pcall-gesichert
        local byawDeg, bpitchDeg = 0.0, 0.0
        if InBackYaw then
            local okY, yv = pcall(function() return InBackYaw:GetValue(req) end)
            if okY and yv ~= nil then
                local val = yv.Value
                if val == nil then val = yv.value end
                if type(val) == "number" then byawDeg = val end
            end
        end
        if InBackPitch then
            local okP, pv = pcall(function() return InBackPitch:GetValue(req) end)
            if okP and pv ~= nil then
                local val = pv.Value
                if val == nil then val = pv.value end
                if type(val) == "number" then bpitchDeg = val end
            end
        end
        paramblock.byaw = byawDeg * 3.14159265358979 / 180.0
        paramblock.bpitch = bpitchDeg * 3.14159265358979 / 180.0
        paramblock.insize[0]  = front.DataWindow:Width()
        paramblock.insize[1]  = front.DataWindow:Height()
        paramblock.outsize[0] = ow
        paramblock.outsize[1] = oh
        node:SetParamBlock(paramblock)

        node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR,
                        TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_TRUE)
        node:AddSampler("RowSampler2", TEX_FILTER_MODE_LINEAR,
                        TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_TRUE)
        node:AddInput("src", front)
        node:AddInput("src2", back)
        node:AddOutput("dst", out)

        local okRun = node:RunSession(req)
        if not okRun then
            LogFuse("kernel run failed")
        end

        OutImage:Set(req, out)
    end)
    if not ok then
        LogFuse("Process error: " .. tostring(perr))
        local front = InFront:GetValue(req)
        OutImage:Set(req, Image({ IMG_Like = front }))
    end
end

function LogFuse(msg)
    local okL, f = pcall(function() return io.open("C:\\Users\\stefa\\AppData\\Local\\hermes\\cache\\scratch\\x6\\fuse_log.txt", "a") end)
    if okL and f then
        f:write(msg .. "\n")
        f:close()
    end
end